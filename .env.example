# Copy to .env and adjust. .env is git-ignored.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Trained model directories (see README, section "Models"). If absent, the rule
# baseline is used and the API reports extractor "rule-baseline".
SCIGRAPH_NER_DIR=models/ner
SCIGRAPH_RE_DIR=models/re
# auto | neural | rules
SCIGRAPH_EXTRACTOR=auto
